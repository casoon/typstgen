{
  "schemaVersion": 1,
  "type": "flow",
  "title": "Workflow with typstgen",
  "description": "Data and template make the source; check and preview show errors and layout, compile writes the PDF/A (with ZUGFeRD XML for invoices) and records it in the manifest; verify proves later that nothing has changed.",
  "source": "typstgen 0.4 (as of 11 October 2026)",
  "locale": "en",
  "width": 960,
  "height": 920,
  "flow": {
    "lanes": [
      {
        "id": "write",
        "label": "Create"
      },
      {
        "id": "check",
        "label": "Check"
      },
      {
        "id": "keep",
        "label": "Keep"
      }
    ],
    "nodes": [
      {
        "id": "data",
        "label": "Data",
        "sublabel": "JSON, BibTeX",
        "kind": "start",
        "lane": "write"
      },
      {
        "id": "doc",
        "label": "Document",
        "sublabel": ".typ + template",
        "lane": "write"
      },
      {
        "id": "check",
        "label": "check",
        "sublabel": "Errors with line",
        "lane": "check"
      },
      {
        "id": "ok",
        "label": "No errors?",
        "kind": "decision",
        "lane": "check"
      },
      {
        "id": "preview",
        "label": "preview",
        "sublabel": "Page as image",
        "lane": "check"
      },
      {
        "id": "compile",
        "label": "compile",
        "sublabel": "PDF/A, ZUGFeRD",
        "lane": "keep"
      },
      {
        "id": "manifest",
        "label": "Manifest",
        "sublabel": "SHA-256",
        "lane": "keep"
      },
      {
        "id": "verify",
        "label": "verify",
        "sublabel": "Rebuild identical",
        "kind": "end",
        "lane": "keep"
      }
    ],
    "edges": [
      {
        "from": "data",
        "to": "doc"
      },
      {
        "from": "doc",
        "to": "check"
      },
      {
        "from": "check",
        "to": "ok"
      },
      {
        "from": "ok",
        "to": "doc",
        "label": "no",
        "dash": "dashed"
      },
      {
        "from": "ok",
        "to": "preview",
        "label": "yes"
      },
      {
        "from": "preview",
        "to": "compile"
      },
      {
        "from": "compile",
        "to": "manifest"
      },
      {
        "from": "manifest",
        "to": "verify",
        "label": "later, in CI"
      }
    ],
    "groups": [
      {
        "label": "also via MCP (AI agent)",
        "nodes": ["check", "ok", "preview"]
      }
    ],
    "mainPath": ["data", "doc", "check", "ok", "preview", "compile", "manifest", "verify"]
  }
}
