---
import {
  Badge,
  Badges,
  Button,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { url } from '@casoon/pages-theme/url';
// Animated SVGs built with castwright from site/captures/compile*.terminal.yaml (real runs, see
// capture.sh); the narrow one is for phones. letter-page.webp is page 1 of examples/letter.pdf.
import compileNarrowSvg from '../../captures/compile-narrow.svg?url';
import compileSvg from '../../captures/compile.svg?url';
import fontsPage from '../../captures/fonts-page.webp?url';
import letterPage from '../../captures/letter-page.webp?url';
import thesisPage from '../../captures/thesis-page.webp?url';
import Diagram from '../components/Diagram.astro';
---

<Base>
  <Hero
    layout="editorial"
    title="Typst in, PDF out."
    lead="typstgen compiles .typ files to PDF with the Typst engine built in: no typst binary, no subprocess, and templates found through a config file instead of hardcoded paths. From the shell, from Rust, in the browser or from your AI agent."
  >
    <div class="get">
      <Install
        commands={[
          { label: 'cargo', command: 'cargo install typstgen' },
          { label: 'library', command: 'cargo add typstgen --no-default-features' },
          { label: 'MCP', command: 'claude mcp add typstgen -- typstgen mcp --root .' },
        ]}
      />
    </div>
    <div slot="output">
      <div class="scene">
        <picture class="terminal-demo">
          <source media="(max-width: 640px)" srcset={compileNarrowSvg} width="410.4" height="278" />
          <img
            src={compileSvg}
            width="628.8"
            height="242"
            alt="Terminal: grep template_paths typstgen.toml prints template_paths = [&quot;templates&quot;]. typstgen compile letter.typ prints letter.pdf. typstgen compile missing-import.typ fails with 'error: typst compilation failed: missing-import.typ:2:9: error: file not found (searched at /footer.typ)', and echo $? prints 1."
          />
        </picture>
        <figure class="page">
          <img
            src={letterPage}
            width="700"
            height="640"
            alt="The top of letter.pdf as compiled: the sender line of the letterhead, the recipient Ada Example, the date 14 September 2026, the subject 'Your quote request' and a price table with a total of € 1,800."
          />
          <figcaption>letter.pdf, page 1</figcaption>
        </figure>
      </div>
      <Badges>
        <Badge>MIT</Badge>
        <Badge>crates.io {config.version}</Badge>
        <Badge>Rust 1.92+</Badge>
        <Badge>Typst 0.15</Badge>
      </Badges>
    </div>
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Teams generating letters, invoices and reports',
        body: 'Your layouts live in Typst templates. typstgen compiles each document against them, the same way on a laptop and in CI.',
      },
      {
        title: 'Rust developers who need PDFs',
        body: 'Add the crate and get the PDF as bytes from one function call. No typst install on the server, no temporary files.',
      },
      {
        title: 'Anyone writing documents with an AI agent',
        body: 'Over MCP the agent checks the document, looks at a page and compiles it, and reads Typst’s errors with file, line and column.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '0', label: 'typst binaries or subprocesses needed' },
      { value: '4', label: 'ways in: CLI, Rust library, Wasm, MCP server' },
      { value: '4', label: 'MCP tools: check, preview, compile, list_templates' },
      { value: '17', label: 'bundled font files, also in Wasm' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You run <code>typstgen compile</code>, or your AI agent calls the MCP server. Either way the
        document goes to the Typst engine that is compiled into typstgen.
      </p>
      <p>
        Imports are looked up next to the document first, then in the template directories listed
        in <code>typstgen.toml</code>. You get a PDF, or Typst’s error with its exact position and
        exit code 1.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 420, height: 620 }} />
    <div class="links">
      <Button href={url('docs/guides/templates/')} variant="secondary">Templates and imports</Button>
      <Button href={url('docs/guides/ai-agents/')} variant="secondary">AI agents over MCP</Button>
      <Button href={url('docs/reference/configuration/')} variant="quiet">typstgen.toml →</Button>
    </div>
  </section>

  <Features
    heading="What you get"
    items={[
      {
        title: 'The same PDF on every machine',
        body: 'Typst’s fallback fonts are always bundled. Switch off system fonts, pin the creation date, and the same input gives the same bytes.',
      },
      {
        title: 'PDF/A, PDF/UA and e-invoices',
        body: 'Enforce PDF/A-2b or PDF/UA-1, and embed ZUGFeRD / Factur-X invoice data for EN 16931.',
      },
      {
        title: 'Archives you can prove',
        body: 'A manifest records each build; typstgen verify later shows that every PDF is unchanged and rebuilds byte for byte.',
      },
    ]}
  />

  <Quickstart
    lead="From a .typ file to a PDF in three steps. Every PDF on this page was compiled by typstgen from the files in examples/."
    steps={[
      'Install the CLI with <code>cargo install typstgen</code>.',
      'List your template directories in <code>typstgen.toml</code>, for example <code>template_paths = ["templates"]</code>.',
      'Run <code>typstgen compile letter.typ</code>. The PDF lands next to it.',
    ]}
  >
    <div class="more">
      <a class="thumb" href={url('showcase/thesis/')}>
        <img
          src={thesisPage}
          width="480"
          height="679"
          alt="Title page of thesis.pdf: a seminar paper titled 'Reproduzierbare Dokumente mit Typst' by Ada Example, Example University."
        />
        <span><strong>thesis.pdf</strong> 7 pages, PDF/A-2b, layout from an @local package</span>
      </a>
      <a class="thumb" href={url('showcase/fonts/')}>
        <img
          src={fontsPage}
          width="480"
          height="682"
          alt="fonts.pdf: sample lines in Libertinus Serif, New Computer Modern, New Computer Modern Math and DejaVu Sans Mono."
        />
        <span><strong>fonts.pdf</strong> every bundled font family, system fonts off</span>
      </a>
    </div>
  </Quickstart>
</Base>

<style>
  /* The install tabs keep their full width beside the lead. */
  .get {
    width: min(100%, 470px);
  }
  /* Terminal and the PDF it wrote, side by side; stacked on narrow screens. The badges sit
     below them, so the install box beside the lead is as tall as the lead and both line up. */
  .scene {
    margin-bottom: 28px;
    display: grid;
    grid-template-columns: minmax(0, 629px) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  @media (max-width: 900px) {
    .scene {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .terminal-demo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .page {
    max-width: 420px;
    margin: 0;
    justify-self: center;
  }
  .page img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 12px 32px -18px rgb(0 0 0 / 0.35);
  }
  .page figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: center;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .text code {
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--code-bg);
    font-size: 13.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .thumb {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--muted);
    font-size: 13.5px;
    text-decoration: none;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    transition: border-color 0.15s;
  }
  .thumb:hover img,
  .thumb:focus-visible img {
    border-color: var(--border-strong);
  }
  .thumb strong {
    display: block;
    color: var(--heading);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }
</style>
